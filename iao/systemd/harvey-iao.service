[Unit]
Description=Harvey (IA Operacional) - motor de prospeccao da Kate: heartbeat (t_b84784f5)
Documentation=file://%h/brains/iaoperacional-brain/areas/produto/harvey.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos-iao/harvey
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HARVEY_IAO_REMETENTE=kate
Environment=PYTHONUNBUFFERED=1
# Registra no journal o commit que este start carrega (instalacao editavel: o codigo e o do checkout).
ExecStartPre=/bin/sh -c 'echo "harvey-iao: commit $$(git -C %h/repos-iao/harvey rev-parse --short HEAD) branch $$(git -C %h/repos-iao/harvey rev-parse --abbrev-ref HEAD)"'
ExecStartPre=%h/repos-iao/harvey/iao/monta-regras.sh
# O heartbeat abre o assistente de setup se .env nao existir. Aqui ele fica vazio:
# nenhuma chave, o envio usa a SA pelo email_iao.py.
ExecStartPre=/bin/sh -c 'test -e %h/repos-iao/harvey/.env || install -m 600 /dev/null %h/repos-iao/harvey/.env'
ExecStart=%h/repos-iao/harvey/.venv/bin/harvey run
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
